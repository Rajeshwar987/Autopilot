# ---- LLM (any OpenAI-compatible endpoint) ----
# Alibaba Cloud Model Studio token plan (plan-exclusive URL shown on your plan page). Coding Plan: https://coding-intl.dashscope.aliyuncs.com/v1
LLM_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-sp-xxxxxxxx
LLM_MODEL=qwen3.7-plus

# ---- Warehouse ----
# Local dev:  WAREHOUSE_URL=autopilot.duckdb
# MotherDuck: WAREHOUSE_URL=md:autopilot?motherduck_token=YOUR_TOKEN
WAREHOUSE_URL=autopilot.duckdb

# ---- OpenSky (optional; anonymous works with 400 credits/day) ----
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Bounding box (default: Europe). 1 credit per call when area <= 25 sq deg... Europe is 4 credits.
OPENSKY_BBOX=35,-15,72,40

# ---- Chaos (optional; same as --chaos flag) ----
CHAOS_FAULT=
